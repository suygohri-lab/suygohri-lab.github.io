---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="py-16 text-center">
    <p class="font-mono text-sm font-semibold text-indigo-600 dark:text-indigo-400">404</p>
    <h1 class="mt-2 text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">The page you are looking for does not exist or has moved.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationList from "../components/PublicationList.astro";
import { site } from "../data/site";
import { getPublications, groupByYear } from "../utils/publications";

const publications = await getPublications();
const byYear = groupByYear(publications);
---

<BaseLayout title="Publications" description={`Publications by ${site.name}.`}>
  <header class="mb-12">
    <h1 class="text-4xl font-bold">Publications</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      {publications.length} papers. <strong class="font-semibold text-slate-900 dark:text-slate-100">Bold</strong> marks
      my name; * denotes equal contribution. See also{" "}
      <a class="link" href={site.socials.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>.
    </p>
  </header>

  <div class="space-y-14">
    {
      byYear.map(([year, pubs]) => (
        <section aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="section-title font-mono text-xl text-slate-500 dark:text-slate-400">
            {year}
          </h2>
          <PublicationList publications={pubs} />
        </section>
      ))
    }
  </div>
</BaseLayout>

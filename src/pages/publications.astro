---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PublicationList from "../components/PublicationList.astro";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import { site } from "../data/site";
import { getPublications, groupByYear } from "../utils/publications";

const publications = await getPublications();
const byYear = groupByYear(publications);
---

<BaseLayout title="Publications" description={`Publications by ${site.name}.`}>
  <PageHeader
    eyebrow={`${publications.length} papers`}
    title="Publications"
    description="My name is shown in <strong class='font-semibold text-fg'>bold</strong>; * marks equal contribution."
  >
    <Button href={site.socials.scholar} variant="secondary" external>
      <Icon name="scholar" class="size-4" /> Google Scholar
    </Button>
  </PageHeader>

  <section aria-label="Papers by year" class="pb-24 md:pb-32">
    <Container class="space-y-16 md:space-y-20">
      {
        byYear.map(([year, pubs]) => (
          <section aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="mb-8 tabular-nums" data-reveal>
              {year}
            </h2>
            <PublicationList publications={pubs} />
          </section>
        ))
      }
    </Container>
  </section>
</BaseLayout>

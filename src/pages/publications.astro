---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationList from "../components/PublicationList.astro";
import { site } from "../data/site";
import { getPublications, groupByYear } from "../utils/publications";

const publications = await getPublications();
const byYear = groupByYear(publications);
---

<BaseLayout title="Publications" description={`Publications by ${site.name}.`}>
  <header class="mb-16">
    <h1 class="text-3xl tracking-[-0.03em] sm:text-4xl">Publications</h1>
    <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
      {publications.length} papers. <strong class="font-semibold text-fg">Bold</strong> marks my name;
      * denotes equal contribution. Full list on{" "}
      <a class="link" href={site.socials.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>.
    </p>
  </header>

  <div class="space-y-20">
    {
      byYear.map(([year, pubs]) => (
        <section aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="section-label">
            {year}
          </h2>
          <PublicationList publications={pubs} />
        </section>
      ))
    }
  </div>
</BaseLayout>

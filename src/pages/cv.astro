---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import CvSection from "../components/CvSection.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/ui/Section.astro";
import { site } from "../data/site";
import { awards, education, experience, service, skills, teaching } from "../data/cv";

// The download button only appears once public/cv.pdf exists.
const hasPdf = existsSync(join(process.cwd(), "public", "cv.pdf"));

// The last section shows only the groups that have entries, e.g. "Honors & skills".
const extras = [
  awards.length > 0 && "Honors",
  service.length > 0 && "service",
  skills.length > 0 && "skills",
].filter((name): name is string => Boolean(name));
const joined = extras.length === 1 ? extras[0] : `${extras.slice(0, -1).join(", ")} & ${extras.at(-1)}`;
const extrasTitle = joined.charAt(0).toUpperCase() + joined.slice(1);
const extraColumns: Record<number, string> = { 1: "max-w-2xl", 2: "md:grid-cols-2", 3: "md:grid-cols-3" };
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}.`}>
  <PageHeader
    eyebrow="Curriculum vitae"
    title="Education & experience"
    description="My academic background, research and teaching experience, and service."
  >
    {
      hasPdf && (
        <Button href="/cv.pdf" download>
          <Icon name="download" class="size-4" /> Download PDF
        </Button>
      )
    }
  </PageHeader>

  <CvSection title="Education" entries={education} />
  <CvSection title="Experience" entries={experience} />
  <CvSection title="Teaching" entries={teaching} />

  {
    extras.length > 0 && (
      <Section title={extrasTitle} class="border-t border-line">
        <div class:list={["grid gap-6", extraColumns[extras.length]]}>
          {awards.length > 0 && (
            <Card data-reveal>
              <h3 class="text-lg">Honors &amp; awards</h3>
              <ul class="mt-5 space-y-4">
                {awards.map(({ title, year }) => (
                  <li>
                    <p class="text-base leading-snug text-fg">{title}</p>
                    <p class="mt-0.5 text-sm text-muted tabular-nums">{year}</p>
                  </li>
                ))}
              </ul>
            </Card>
          )}

          {service.length > 0 && (
            <Card data-reveal>
              <h3 class="text-lg">Service</h3>
              <ul class="mt-5 space-y-3 text-base leading-relaxed">
                {service.map((item) => <li>{item}</li>)}
              </ul>
            </Card>
          )}

          {skills.length > 0 && (
            <Card data-reveal>
              <h3 class="text-lg">Skills</h3>
              <dl class="mt-5 space-y-5">
                {skills.map(({ label, items }) => (
                  <div>
                    <dt class="text-sm font-semibold text-muted">{label}</dt>
                    <dd class="mt-2 flex flex-wrap gap-1.5">
                      {items.map((item) => <span class="rounded-md border-2 border-ink px-2 py-0.5 text-sm font-semibold text-fg">{item}</span>)}
                    </dd>
                  </div>
                ))}
              </dl>
            </Card>
          )}
        </div>
      </Section>
    )
  }
</BaseLayout>

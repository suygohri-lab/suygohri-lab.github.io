---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import CvSection from "../components/CvSection.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { awards, education, experience, service, skills, teaching } from "../data/cv";

// The download link only appears once public/cv.pdf exists.
const hasPdf = existsSync(join(process.cwd(), "public", "cv.pdf"));

const row = "grid gap-x-8 gap-y-0.5 sm:grid-cols-[7rem_1fr]";
const rowLabel = "font-mono text-xs leading-6 tracking-wider text-muted uppercase";
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}.`}>
  <header class="mb-16 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl tracking-[-0.03em] sm:text-4xl">Curriculum Vitae</h1>
      <p class="mt-4 text-sm text-muted">Education, research experience, teaching, and service.</p>
    </div>
    {
      hasPdf && (
        <a href="/cv.pdf" class="action" download>
          <Icon name="download" class="size-3.5" /> Download PDF
        </a>
      )
    }
  </header>

  <CvSection title="Education" entries={education} />
  <CvSection title="Experience" entries={experience} />
  <CvSection title="Teaching" entries={teaching} />

  <section class="mt-20">
    <h2 class="section-label">Honors &amp; Awards</h2>
    <ul class="space-y-3">
      {
        awards.map(({ title, year }) => (
          <li class={row}>
            <span class={rowLabel}>{year}</span>
            <span class="text-[15px] leading-6">{title}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-20">
    <h2 class="section-label">Service</h2>
    <ul class="space-y-2 sm:pl-[9rem]">
      {service.map((item) => <li class="text-[15px]">{item}</li>)}
    </ul>
  </section>

  <section class="mt-20">
    <h2 class="section-label">Skills</h2>
    <dl class="space-y-3">
      {
        skills.map(({ label, items }) => (
          <div class={row}>
            <dt class={rowLabel}>{label}</dt>
            <dd class="text-[15px] leading-6">{items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

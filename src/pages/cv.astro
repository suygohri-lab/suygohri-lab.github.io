---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import CvSection from "../components/CvSection.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { awards, education, experience, service, skills, teaching } from "../data/cv";

// The download button only appears once public/cv.pdf exists.
const hasPdf = existsSync(join(process.cwd(), "public", "cv.pdf"));
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}.`}>
  <header class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-4xl font-bold">Curriculum Vitae</h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">Education, research experience, teaching, and service.</p>
    </div>
    {
      hasPdf && (
        <a href="/cv.pdf" class="btn-secondary self-start sm:self-auto" download>
          <Icon name="download" class="size-4" /> Download PDF
        </a>
      )
    }
  </header>

  <CvSection title="Education" entries={education} />
  <CvSection title="Experience" entries={experience} />
  <CvSection title="Teaching" entries={teaching} />

  <section class="mt-14">
    <h2 class="section-title">Honors &amp; Awards</h2>
    <ul class="space-y-2">
      {
        awards.map(({ title, year }) => (
          <li class="flex items-baseline justify-between gap-4">
            <span>{title}</span>
            <span class="shrink-0 font-mono text-sm text-slate-500 dark:text-slate-400">{year}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="section-title">Service</h2>
    <ul class="list-disc space-y-1.5 pl-5 marker:text-slate-400">
      {service.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="section-title">Skills</h2>
    <dl class="space-y-3">
      {
        skills.map(({ label, items }) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:gap-4">
            <dt class="w-28 shrink-0 text-sm font-semibold text-slate-900 dark:text-slate-100">{label}</dt>
            <dd class="flex flex-wrap gap-1.5">
              {items.map((item) => (
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

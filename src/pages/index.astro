---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import PublicationList from "../components/PublicationList.astro";
import { site } from "../data/site";
import { getPublications } from "../utils/publications";

const selected = (await getPublications()).filter((p) => p.data.selected);

// Drop a square photo at public/profile.jpg to show it beside the intro.
const hasPhoto = existsSync(join(process.cwd(), "public", "profile.jpg"));

const formatNewsDate = (ym: string) =>
  new Date(`${ym}-01T00:00:00`).toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<BaseLayout>
  <!-- Hero -->
  <section class="flex flex-col-reverse gap-10 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-muted uppercase">{site.title}</p>
      <h1 class="mt-4 text-4xl tracking-[-0.03em] sm:text-5xl">{site.name}</h1>

      <p class="mt-5 text-sm leading-relaxed text-muted">
        {site.affiliation.department},{" "}
        <a class="link" href={site.affiliation.url} target="_blank" rel="noopener noreferrer">
          {site.affiliation.university}
        </a>
        <br />
        <a class="link" href={site.lab.url} target="_blank" rel="noopener noreferrer">{site.lab.name}</a>
        {" "}&middot; Advised by{" "}
        <a class="link" href={site.advisor.url} target="_blank" rel="noopener noreferrer">{site.advisor.name}</a>
      </p>

      <div class="mt-8 space-y-4 leading-[1.75]">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs tracking-wider text-accent uppercase" aria-label="Research interests">
        {site.researchInterests.map((interest) => <li>{interest}</li>)}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/cv/" class="action">
          View CV <Icon name="arrow" class="size-3.5" />
        </a>
        <SocialLinks />
      </div>
    </div>

    {
      hasPhoto && (
        <img
          src="/profile.jpg"
          alt={`Portrait of ${site.name}`}
          width="128"
          height="128"
          class="size-28 shrink-0 rounded-full object-cover sm:size-32"
        />
      )
    }
  </section>

  <!-- News -->
  {
    site.news.length > 0 && (
      <section class="mt-24">
        <h2 class="section-label">News</h2>
        <ul class="space-y-4">
          {site.news.map(({ date, text }) => (
            <li class="grid gap-x-8 gap-y-0.5 sm:grid-cols-[7rem_1fr]">
              <time datetime={date} class="font-mono text-xs leading-6 tracking-wider text-muted uppercase tabular-nums">
                {formatNewsDate(date)}
              </time>
              <span class="text-sm leading-6 sm:text-[15px]">{text}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Selected publications -->
  <section class="mt-24">
    <h2 class="section-label">Selected Publications</h2>
    <PublicationList publications={selected} />
    <a href="/publications/" class="action mt-12 sm:ml-[9rem]">
      All publications <Icon name="arrow" class="size-3.5" />
    </a>
  </section>
</BaseLayout>

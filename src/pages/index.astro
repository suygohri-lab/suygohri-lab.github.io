---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import PublicationList from "../components/PublicationList.astro";
import { site } from "../data/site";
import { getPublications } from "../utils/publications";

const selected = (await getPublications()).filter((p) => p.data.selected);

// Drop a square photo at public/profile.jpg to replace the initials avatar.
const hasPhoto = existsSync(join(process.cwd(), "public", "profile.jpg"));
const initials = site.name
  .split(/\s+/)
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const formatNewsDate = (ym: string) =>
  new Date(`${ym}-01T00:00:00`).toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<BaseLayout>
  <!-- Hero -->
  <section class="flex flex-col-reverse gap-10 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-2xl">
      <p class="mb-3 text-sm font-semibold tracking-wider text-indigo-600 uppercase dark:text-indigo-400">
        {site.title}
      </p>
      <h1 class="text-4xl font-bold sm:text-5xl">{site.name}</h1>

      <div class="mt-4 space-y-1.5 text-slate-600 dark:text-slate-400">
        <p class="flex items-start gap-2">
          <Icon name="cap" class="mt-1 size-4 shrink-0 text-slate-400" />
          <span>
            {site.affiliation.department},{" "}
            <a class="link" href={site.affiliation.url} target="_blank" rel="noopener noreferrer">
              {site.affiliation.university}
            </a>
          </span>
        </p>
        <p class="flex items-start gap-2 text-sm">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-slate-400" />
          <span>
            <a class="link" href={site.lab.url} target="_blank" rel="noopener noreferrer">{site.lab.name}</a>
            {" "}&middot; Advised by{" "}
            <a class="link" href={site.advisor.url} target="_blank" rel="noopener noreferrer">{site.advisor.name}</a>
          </span>
        </p>
      </div>

      <div class="mt-6 space-y-4 text-base leading-relaxed sm:text-[17px]">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Research interests">
        {
          site.researchInterests.map((interest) => (
            <li class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 ring-1 ring-slate-200 ring-inset dark:bg-slate-800/60 dark:text-slate-300 dark:ring-slate-700">
              {interest}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/cv/" class="btn-primary">
          View CV <Icon name="arrow" class="size-4" />
        </a>
        <SocialLinks />
      </div>
    </div>

    <div class="shrink-0">
      {
        hasPhoto ? (
          <img
            src="/profile.jpg"
            alt={`Portrait of ${site.name}`}
            width="176"
            height="176"
            class="size-36 rounded-2xl object-cover shadow-lg ring-1 ring-slate-200 sm:size-44 dark:ring-slate-800"
          />
        ) : (
          <div
            aria-hidden="true"
            class="grid size-36 place-items-center rounded-2xl bg-gradient-to-br from-indigo-500 to-slate-700 font-serif text-5xl font-semibold text-white shadow-lg sm:size-44"
          >
            {initials}
          </div>
        )
      }
    </div>
  </section>

  <!-- News -->
  {
    site.news.length > 0 && (
      <section class="mt-20">
        <h2 class="section-title">News</h2>
        <ul class="space-y-3">
          {site.news.map(({ date, text }) => (
            <li class="flex gap-4 text-sm sm:text-base">
              <time datetime={date} class="w-20 shrink-0 font-mono text-sm text-slate-500 tabular-nums dark:text-slate-400">
                {formatNewsDate(date)}
              </time>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Selected publications -->
  <section class="mt-20">
    <h2 class="section-title">Selected Publications</h2>
    <PublicationList publications={selected} />
    <a href="/publications/" class="link mt-6 inline-flex items-center gap-1.5 text-sm no-underline">
      All publications <Icon name="arrow" class="size-4" />
    </a>
  </section>
</BaseLayout>

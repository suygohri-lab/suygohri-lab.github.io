export type IconName = keyof typeof brand | keyof typeof ui;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
const isBrand = name in brand;
---

{
  isBrand ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={brand[name as keyof typeof brand]} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={ui[name as keyof typeof ui]}
    />
  )
}

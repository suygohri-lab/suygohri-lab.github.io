---
import Icon from "./Icon.astro";
import Card from "./ui/Card.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, status, tags, icon, image, imageAlt, link } = project;
---

<Card as="article" interactive padded={false} class="group flex h-full flex-col overflow-hidden" data-reveal>
  <div class="relative aspect-video overflow-hidden border-b-2 border-ink bg-card">
    {
      image ? (
        <img
          src={image}
          alt={imageAlt ?? ""}
          loading="lazy"
          class="size-full object-cover transition-all duration-200 ease-in-out group-hover:scale-[1.02]"
        />
      ) : (
        <div class="halftone grid size-full place-items-center">
          <span class="comic-button grid size-14 place-items-center rounded-2xl bg-card text-art-2 group-hover:-translate-x-px group-hover:-translate-y-px">
            <Icon name={icon} class="size-7" />
          </span>
        </div>
      )
    }
    <span class="absolute top-4 left-4 rounded-full border-2 border-ink bg-highlight px-2.5 py-0.5 text-xs font-bold text-fg uppercase">
      {status}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg leading-snug">{title}</h3>
    <p class="mt-3 flex-1 text-base leading-relaxed text-muted">{summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Topics">
      {tags.map((tag) => <li class="rounded-md border-2 border-ink px-2 py-0.5 text-xs font-semibold text-fg">{tag}</li>)}
    </ul>
    {
      link && (
        <a href={link.url} class="text-action mt-6" target="_blank" rel="noopener noreferrer">
          {link.label} <Icon name="arrow" class="size-4" />
        </a>
      )
    }
  </div>
</Card>

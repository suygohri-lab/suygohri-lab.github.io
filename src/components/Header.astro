---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Container from "./ui/Container.astro";
import { nav, site } from "../data/site";

const strip = (path: string) => path.replace(/\/+$/, "") || "/";
const current = strip(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/" ? current === "/" : current === strip(href) || current.startsWith(strip(href) + "/");

const linkClass =
  "rounded-lg px-3 py-2 text-sm font-medium text-muted transition-all duration-200 ease-in-out hover:bg-surface hover:text-fg aria-[current=page]:text-link";
---

<!-- data-companion-*: Minerva the owl perches on this header, in the gap after the name and before the controls. -->
<header data-companion-perch class="sticky top-0 z-40 border-b-2 border-ink bg-bg/95 sm:bg-bg/85 sm:backdrop-blur-md">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a href="/" data-companion-perch-after class="inline-flex min-h-11 items-center text-base font-bold tracking-tight text-fg transition-all duration-200 ease-in-out hover:text-link">
      {site.name}
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Main" data-companion-perch-before class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            nav.map(({ label, href }) => (
              <li>
                <a href={href} aria-current={isActive(href) ? "page" : undefined} class={linkClass}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />

      <button
        type="button"
        id="menu-button"
        data-companion-perch-before
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="group grid size-11 place-items-center rounded-lg text-muted transition-all duration-200 ease-in-out hover:bg-surface hover:text-fg sm:hidden"
      >
        <Icon name="menu" class="size-5 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-5 group-aria-expanded:block" />
      </button>
    </div>
  </Container>

  <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-line/70 sm:hidden">
    <Container>
      <ul class="flex flex-col gap-1 py-3">
        {
          nav.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={isActive(href) ? "page" : undefined} class:list={[linkClass, "flex min-h-11 items-center"]}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </nav>
</header>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-nav");

  const setOpen = (open: boolean) => {
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu?.classList.toggle("hidden", !open);
    document.dispatchEvent(new CustomEvent("companion", { detail: { type: "menu", open } }));
  };

  button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));

  // Escape closes the menu and returns focus to the button.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });
</script>

---
import Icon from "./Icon.astro";
import { isSelf, type Publication } from "../utils/publications";

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const { title, authors, venue, venueShort, year, pdf, code, links, bibtex, award } = publication.data;

// Pass the rendered Markdown body (abstract) in the default slot to enable the "Abstract" toggle.
const hasAbstract = Astro.slots.has("default");
const uid = publication.id.replace(/[^a-z0-9-]/gi, "-");
const panelClass =
  "grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-out data-open:mt-4 data-open:grid-rows-[1fr] data-open:opacity-100";
---

<article class="grid gap-x-8 gap-y-1.5 sm:grid-cols-[7rem_1fr]">
  <p class="font-mono text-xs leading-6 tracking-wider text-muted uppercase sm:pt-px">
    {venueShort ?? venue} {year}
  </p>

  <div class="min-w-0">
    <h3 class="text-base leading-snug sm:text-[17px]">{title}</h3>

    <p class="mt-1.5 text-sm leading-relaxed text-text">
      {
        authors.map((author, i) => (
          <>
            {isSelf(author) ? <strong class="font-semibold text-fg">{author}</strong> : author}
            {i < authors.length - 1 && ", "}
          </>
        ))
      }
    </p>

    <p class="mt-0.5 text-sm text-muted">
      <em>{venue}</em>, {year}
      {award && <span class="font-medium text-fg"> &middot; {award}</span>}
    </p>

    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      {
        pdf && (
          <a class="action" href={pdf} target="_blank" rel="noopener noreferrer">
            PDF <Icon name="external" class="size-3" />
          </a>
        )
      }
      {
        code && (
          <a class="action" href={code} target="_blank" rel="noopener noreferrer">
            Code <Icon name="external" class="size-3" />
          </a>
        )
      }
      {
        links.map(({ label, url }) => (
          <a class="action" href={url} target="_blank" rel="noopener noreferrer">
            {label} <Icon name="external" class="size-3" />
          </a>
        ))
      }
      {
        hasAbstract && (
          <button type="button" class="action group/t" data-pub-toggle aria-expanded="false" aria-controls={`abs-${uid}`}>
            Abstract
            <Icon name="chevron" class="size-3 transition-transform group-aria-expanded/t:rotate-180" />
          </button>
        )
      }
      {
        bibtex && (
          <button type="button" class="action group/t" data-pub-toggle aria-expanded="false" aria-controls={`bib-${uid}`}>
            BibTeX
            <Icon name="chevron" class="size-3 transition-transform group-aria-expanded/t:rotate-180" />
          </button>
        )
      }
    </div>

    {
      hasAbstract && (
        <div id={`abs-${uid}`} class={panelClass} inert>
          <div class="overflow-hidden">
            <div class="border-l border-line pl-4 text-sm leading-relaxed text-text">
              <slot />
            </div>
          </div>
        </div>
      )
    }

    {
      bibtex && (
        <div id={`bib-${uid}`} class={panelClass} inert>
          <div class="overflow-hidden">
            <div class="relative">
              <pre class="overflow-x-auto rounded-md bg-surface p-4 pr-12 font-mono text-xs leading-relaxed text-text"><code>{bibtex.trim()}</code></pre>
              <button
                type="button"
                data-copy-bibtex
                aria-label="Copy BibTeX"
                title="Copy BibTeX"
                class="absolute top-3 right-3 grid size-7 place-items-center text-muted transition-colors hover:text-accent"
              >
                <Icon name="copy" class="size-4 [[data-copied]_&]:hidden" />
                <Icon name="check" class="hidden size-4 text-accent [[data-copied]_&]:block" />
              </button>
            </div>
          </div>
        </div>
      )
    }
  </div>
</article>

<script>
  // Event delegation: one listener handles every card on the page.
  document.addEventListener("click", async (event) => {
    const target = event.target as Element;

    const toggle = target.closest<HTMLButtonElement>("[data-pub-toggle]");
    if (toggle) {
      const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
      if (!panel) return;
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      panel.toggleAttribute("data-open", open);
      panel.inert = !open;
      return;
    }

    const copy = target.closest<HTMLButtonElement>("[data-copy-bibtex]");
    if (copy) {
      const text = copy.parentElement?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        copy.setAttribute("data-copied", "");
        setTimeout(() => copy.removeAttribute("data-copied"), 1500);
      } catch {}
    }
  });
</script>

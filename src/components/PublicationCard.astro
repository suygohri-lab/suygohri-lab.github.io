---
import Icon, { type IconName } from "./Icon.astro";
import Card from "./ui/Card.astro";
import { isSelf, type Publication } from "../utils/publications";

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const { title, authors, venue, venueShort, year, pdf, code, links, bibtex, award } = publication.data;

// Pass the rendered Markdown body (abstract) in the default slot to enable the "Abstract" toggle.
const hasAbstract = Astro.slots.has("default");
const uid = publication.id.replace(/[^a-z0-9-]/gi, "-");

const button =
  "comic-button inline-flex items-center gap-1.5 rounded-lg bg-card px-3 py-1.5 text-sm font-semibold text-fg hover:text-link aria-expanded:bg-accent aria-expanded:text-on-accent aria-expanded:hover:text-on-accent";
const panel =
  "grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out data-open:mt-5 data-open:grid-rows-[1fr] data-open:opacity-100";

const outbound: { label: string; url: string; icon: IconName }[] = [
  ...(pdf ? [{ label: "PDF", url: pdf, icon: "pdf" as const }] : []),
  ...(code ? [{ label: "Code", url: code, icon: "code" as const }] : []),
  ...links.map(({ label, url }) => ({ label, url, icon: "external" as const })),
];
---

<Card as="article" interactive>
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-md border-2 border-ink px-2 py-0.5 text-xs font-bold tracking-wide text-fg">
      {venueShort ?? venue} {year}
    </span>
    {
      award && (
        <span class="inline-flex items-center gap-1 rounded-md border-2 border-ink bg-highlight px-2 py-0.5 text-xs font-bold text-fg">
          <Icon name="award" class="size-3.5" />
          {award}
        </span>
      )
    }
  </div>

  <h3 class="mt-4 text-lg leading-snug md:text-xl">{title}</h3>

  <p class="mt-2 text-base leading-relaxed text-text">
    {
      authors.map((author, i) => (
        <>
          {isSelf(author) ? <strong class="font-semibold text-fg">{author}</strong> : author}
          {i < authors.length - 1 && ", "}
        </>
      ))
    }
  </p>
  <p class="mt-1 text-sm text-muted italic">{venue}, {year}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      outbound.map(({ label, url, icon }) => (
        <a class={button} href={url} target="_blank" rel="noopener noreferrer">
          <Icon name={icon} class="size-4" /> {label}
        </a>
      ))
    }
    {
      hasAbstract && (
        <button type="button" class:list={[button, "group/t"]} data-pub-toggle aria-expanded="false" aria-controls={`abs-${uid}`}>
          <Icon name="text" class="size-4" /> Abstract
          <Icon name="chevron" class="size-3.5 transition-all duration-200 ease-in-out group-aria-expanded/t:rotate-180" />
        </button>
      )
    }
    {
      bibtex && (
        <button type="button" class:list={[button, "group/t"]} data-pub-toggle aria-expanded="false" aria-controls={`bib-${uid}`}>
          <Icon name="quote" class="size-4" /> BibTeX
          <Icon name="chevron" class="size-3.5 transition-all duration-200 ease-in-out group-aria-expanded/t:rotate-180" />
        </button>
      )
    }
  </div>

  {
    hasAbstract && (
      <div id={`abs-${uid}`} class={panel} inert>
        <div class="overflow-hidden">
          <div class="max-w-2xl rounded-xl bg-surface px-5 py-4 text-base leading-relaxed text-text">
            <slot />
          </div>
        </div>
      </div>
    )
  }

  {
    bibtex && (
      <div id={`bib-${uid}`} class={panel} inert>
        <div class="overflow-hidden">
          <div class="relative">
            <pre class="overflow-x-auto rounded-xl bg-surface p-5 pr-14 font-mono text-xs leading-relaxed text-text"><code>{bibtex.trim()}</code></pre>
            <button
              type="button"
              data-copy-bibtex
              aria-label="Copy BibTeX"
              title="Copy BibTeX"
              class="comic-button absolute top-3 right-3 grid size-8 place-items-center rounded-lg bg-card text-fg hover:text-link"
            >
              <Icon name="copy" class="size-4 [[data-copied]_&]:hidden" />
              <Icon name="check" class="hidden size-4 text-link [[data-copied]_&]:block" />
            </button>
          </div>
        </div>
      </div>
    )
  }
</Card>

<script>
  // Event delegation: one listener handles every card on the page.
  document.addEventListener("click", async (event) => {
    const target = event.target as Element;

    const toggle = target.closest<HTMLButtonElement>("[data-pub-toggle]");
    if (toggle) {
      const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
      if (!panel) return;
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      panel.toggleAttribute("data-open", open);
      panel.inert = !open;
      return;
    }

    const copy = target.closest<HTMLButtonElement>("[data-copy-bibtex]");
    if (copy) {
      const text = copy.parentElement?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        copy.setAttribute("data-copied", "");
        setTimeout(() => copy.removeAttribute("data-copied"), 1500);
      } catch {}
    }
  });
</script>

---
import SocialLinks from "./SocialLinks.astro";
import Container from "./ui/Container.astro";
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<footer class="border-t-2 border-ink">
  <Container class="flex flex-col gap-8 py-12 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-bold tracking-tight text-fg">{site.name}</p>
      <p class="mt-1 text-sm text-muted">{site.title} &middot; {site.affiliation.university}</p>
      <p class="mt-4 text-sm text-muted">&copy; {year} &middot; Last updated {updated}</p>
    </div>
    <div class="flex flex-col gap-6 md:items-end">
      <nav aria-label="Footer">
        <ul class="flex gap-6 text-sm font-medium">
          {
            nav.map(({ label, href }) => (
              <li>
                <a href={href} class="text-muted transition-all duration-200 ease-in-out hover:text-link">{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <SocialLinks size="sm" />
    </div>
  </Container>
</footer>

---
import SocialLinks from "./SocialLinks.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<footer class="container-page mt-16 flex flex-col items-center justify-between gap-4 pt-10 pb-12 font-mono text-xs tracking-wide text-muted sm:flex-row">
  <p>&copy; {year} {site.name} &middot; Updated {updated}</p>
  <SocialLinks size="sm" />
</footer>

---
/**
 * Decorative background: a trail of footprints that walks after the mouse (or finger)
 * and fades out behind it; when the pointer rests, a pair of feet stands under it.
 * On load, a short intro walk shows the effect once.
 *
 * Built for smooth motion:
 * - Each footprint is its own small element moved with `transform` and faded with
 *   `opacity` through the Web Animations API, so the browser's compositor (GPU) does
 *   the work instead of repainting a full-screen layer every frame.
 * - Fades are time-based (same speed at 60 Hz and 120 Hz).
 * - Footprints never move once placed; fast pointer moves get one footprint per
 *   stride along the path, and each footprint faces the direction of its whole
 *   stride, so hand jitter does not twist the feet.
 */
---

<!-- Shared footprint shapes; each footprint below references one of them. -->
<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  <defs>
    <path
      id="feet-shape"
      d="M41.5,30.2C36,24.6,4.7,26.1,7.7,49.4c.8,5.9,4,10.2,8,19.9,3,7.2-.1,15.7,5.8,20.8S43,91.6,38.6,75.9c-1.8-6.5-7.6-9.3-8.9-14.1C26.1,47.9,51.7,40.6,41.5,30.2Z M41.7,7.6c-2.6-.3-5.2,2.8-5.6,7s1.3,7.8,3.9,8.1,5.2-2.9,5.6-7.1S44.4,7.8,41.7,7.6Z M28.8,21.9c2.2.2,4.1-2.1,4.5-5.1s-1.1-5.7-3.2-6-4.1,2.1-4.5,5.1S26.7,21.6,28.8,21.9Z M20.1,23.3c1.6.1,3.1-1.8,3.4-4.4s-.8-4.7-2.4-4.9-3,1.8-3.3,4.3S18.5,23.1,20.1,23.3Z M14.9,25.5c1.4-.2,2.4-1.9,2.1-3.9s-1.6-3.4-3-3.3-2.4,2-2.2,3.9S13.4,25.7,14.9,25.5Z M10.9,29.2c1-.1,1.7-1.4,1.5-2.8s-1.1-2.5-2.2-2.4-1.7,1.4-1.6,2.8S9.8,29.3,10.9,29.2Z"
    ></path>
    <symbol id="feet-left" viewBox="0 0 100 100">
      <use href="#feet-shape"></use>
    </symbol>
    <symbol id="feet-right" viewBox="0 0 100 100">
      <g transform="scale(-1, 1) translate(-100, 0)">
        <use href="#feet-shape"></use>
      </g>
    </symbol>
  </defs>
</svg>

<div class="footsteps" aria-hidden="true"></div>

<style>
  /* Fixed behind all content; never catches clicks; hidden when printing. */
  .footsteps {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Mid palette blue, softened: clearly visible, but stays behind text and cards. */
    opacity: 0.45;
  }
  .footsteps :global(.foot) {
    position: absolute;
    top: 0;
    left: 0;
    width: 50px;
    height: 50px;
    opacity: 0;
    fill: var(--art-3);
    will-change: transform, opacity;
  }
  @media print {
    .footsteps {
      display: none;
    }
  }
</style>

<script>
  const SVG_NS = "http://www.w3.org/2000/svg";
  const SIZE = 50; // footprint size (px)
  const STRIDE = 70; // distance between footprints along the path (px)
  const TRAIL = 12; // footprints recycled for the trail
  const STAND_AFTER = 140; // ms without movement before the feet "stand"
  const STAND_BEHIND = 25; // standing feet sit this far behind the pointer (px)

  const layer = document.querySelector<HTMLDivElement>(".footsteps");

  if (layer) {
    type Foot = { el: SVGSVGElement; use: SVGUseElement };

    const makeFoot = (): Foot => {
      const el = document.createElementNS(SVG_NS, "svg");
      el.setAttribute("viewBox", "0 0 100 100");
      el.classList.add("foot");
      const use = document.createElementNS(SVG_NS, "use");
      el.append(use);
      layer.append(el);
      return { el, use };
    };

    const trail = Array.from({ length: TRAIL }, makeFoot);
    const stand = [makeFoot(), makeFoot()];
    let nextFoot = 0;
    let steps = 0;

    // Footprint positions are only ever set once, before the foot fades in.
    const place = (foot: Foot, x: number, y: number, angle: number, isLeft: boolean) => {
      foot.use.setAttribute("href", isLeft ? "#feet-left" : "#feet-right");
      foot.el.style.transform = `translate3d(${x - SIZE / 2}px, ${y - SIZE / 2}px, 0) rotate(${angle}deg)`;
    };
    const fade = (foot: Foot, keyframes: Keyframe[], duration: number) => {
      for (const a of foot.el.getAnimations()) a.cancel();
      return foot.el.animate(keyframes, { duration, easing: "ease-out", fill: "forwards" });
    };
    // Same orientation formula as the original demo, from a direction vector.
    const angleOf = (ux: number, uy: number) => (1 - Math.atan2(ux, uy) / Math.PI) * 180;

    const stepAt = (x: number, y: number, ux: number, uy: number) => {
      const foot = trail[nextFoot];
      nextFoot = (nextFoot + 1) % TRAIL;
      place(foot, x, y, angleOf(ux, uy), steps % 2 === 0);
      steps++;
      // Quick fade in, short hold, then a gentle time-based fade out.
      fade(foot, [{ opacity: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.35 }, { opacity: 0 }], 1400);
    };

    // ---- Pointer tracking: events only record the position; work happens once per frame.
    let target: { x: number; y: number } | null = null;
    let last: { x: number; y: number } | null = null; // where the previous stride ended
    let heading = { ux: 0, uy: 1 };
    let standing = false;
    let frameQueued = false;
    let standTimer = 0;

    const standUp = () => {
      if (!target) return;
      const x = target.x - heading.ux * STAND_BEHIND;
      const y = target.y - heading.uy * STAND_BEHIND;
      const angle = angleOf(heading.ux, heading.uy);
      place(stand[0], x, y, angle, true);
      place(stand[1], x, y, angle, false);
      fade(stand[0], [{ opacity: 0 }, { opacity: 1 }], 220);
      fade(stand[1], [{ opacity: 0 }, { opacity: 1 }], 320); // second foot lands a beat later
      standing = true;
    };
    const sitDown = () => {
      if (!standing) return;
      standing = false;
      for (const foot of stand) fade(foot, [{ opacity: Number(getComputedStyle(foot.el).opacity) }, { opacity: 0 }], 200);
    };

    const processFrame = () => {
      frameQueued = false;
      if (!target) return;
      if (!last) {
        last = { ...target };
        return;
      }
      let dx = target.x - last.x;
      let dy = target.y - last.y;
      let dist = Math.hypot(dx, dy);
      // One footprint per full stride along the path (several if the pointer moved fast).
      while (dist >= STRIDE) {
        const ux = dx / dist;
        const uy = dy / dist;
        last = { x: last.x + ux * STRIDE, y: last.y + uy * STRIDE };
        heading = { ux, uy };
        stepAt(last.x, last.y, ux, uy);
        dx = target.x - last.x;
        dy = target.y - last.y;
        dist = Math.hypot(dx, dy);
      }
    };

    const onPointerMove = (x: number, y: number) => {
      target = { x, y };
      sitDown();
      if (!frameQueued) {
        frameQueued = true;
        requestAnimationFrame(processFrame);
      }
      clearTimeout(standTimer);
      standTimer = window.setTimeout(standUp, STAND_AFTER);
    };

    // ---- Intro: walk in from the bottom-left to 40% across, 60% down the screen.
    let introPlaying = false;
    const introAnimation = () => {
      introPlaying = true;
      const DURATION = 1100;
      const start = performance.now();
      const from = { x: -100, y: innerHeight };
      const to = { x: 0.4 * innerWidth, y: 0.6 * innerHeight };
      const easeOut = (t: number) => 1 - (1 - t) ** 2; // power1.out
      const backOut = (t: number, s = 3) => 1 + (s + 1) * (t - 1) ** 3 + s * (t - 1) ** 2; // back.out(3)
      const tick = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        onPointerMove(from.x + (to.x - from.x) * easeOut(t), from.y + (to.y - from.y) * backOut(t));
        if (t < 1) requestAnimationFrame(tick);
        else introPlaying = false;
      };
      requestAnimationFrame(tick);
    };

    addEventListener("mousemove", (e) => {
      if (!introPlaying) onPointerMove(e.clientX, e.clientY);
    });
    addEventListener(
      "touchmove",
      (e) => {
        const touch = e.touches[0];
        if (!introPlaying && touch) onPointerMove(touch.clientX, touch.clientY);
      },
      { passive: true },
    );

    // Skip the automatic intro walk for visitors who asked for reduced motion;
    // footprints still follow their own pointer.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) introAnimation();
  }
</script>

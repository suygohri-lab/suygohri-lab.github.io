---
import { project, sphereCurve, stateFrame, THETA, VIEW } from "../../utils/bloch";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { cx, cy, r } = VIEW;

const curves = [
  sphereCurve((t) => [Math.cos(t), Math.sin(t), 0]), // equator
  sphereCurve((t) => [Math.sin(t), 0, Math.cos(t)]), // x–z meridian
  sphereCurve((t) => [0, Math.sin(t), Math.cos(t)]), // y–z meridian
];
const orbit = sphereCurve((t) => [Math.sin(THETA) * Math.cos(t), Math.sin(THETA) * Math.sin(t), Math.cos(THETA)]);

const axes = [
  { from: project([0, 0, -1]), to: project([0, 0, 1]) },
  { from: project([-1, 0, 0]), to: project([1, 0, 0]) },
  { from: project([0, -1, 0]), to: project([0, 1, 0]) },
];
const poles = [project([0, 0, 1]), project([0, 0, -1])];

const PHI0 = 0.9;
const TRAIL = 10;
const s = stateFrame(THETA, PHI0);
const trail = Array.from({ length: TRAIL }, (_, i) => stateFrame(THETA, PHI0 - (i + 1) * 0.07).tip);
---

<figure class:list={["halftone", className]}>
  <svg viewBox="0 0 240 240" class="w-full" role="img" aria-label="Animated Bloch sphere showing a qubit state">
    <circle cx={cx} cy={cy} r={r} fill="var(--art-4)" fill-opacity="0.14" stroke="var(--muted)" stroke-opacity="0.7" />

    <g fill="none" stroke="var(--muted)" stroke-width="1">
      {curves.map((c) => <path d={c.back} stroke-opacity="0.35" stroke-dasharray="2 3" />)}
      {curves.map((c) => <path d={c.front} stroke-opacity="0.6" />)}
      {axes.map(({ from, to }) => <line x1={from[0]} y1={from[1]} x2={to[0]} y2={to[1]} stroke-opacity="0.4" />)}
    </g>

    <g class="bloch-orbit" fill="none" stroke="var(--art-2)" stroke-width="1.25" stroke-dasharray="3 3">
      <path d={orbit.back} stroke-opacity="0.45" />
      <path d={orbit.front} />
    </g>

    {poles.map(([x, y]) => <circle cx={x} cy={y} r="2.5" fill="var(--muted)" fill-opacity="0.7" />)}

    <g data-bloch-state class="transition-opacity duration-700">
      <circle data-part="ring" cx={poles[0][0]} cy={poles[0][1]} r="4" fill="none" stroke="var(--art-2)" stroke-width="1.5" opacity="0" />
      {
        trail.map(([x, y], i) => (
          <circle
            data-part="trail"
            cx={x}
            cy={y}
            r={(3 - i * 0.2).toFixed(2)}
            fill="var(--art-2)"
            opacity={((1 - (i + 1) / (TRAIL + 1)) * 0.55).toFixed(2)}
          />
        ))
      }
      <line data-part="drop" x1={s.tip[0]} y1={s.tip[1]} x2={s.foot[0]} y2={s.foot[1]} stroke="var(--art-2)" stroke-opacity="0.6" stroke-dasharray="2 2" />
      <line data-part="proj" x1={s.origin[0]} y1={s.origin[1]} x2={s.foot[0]} y2={s.foot[1]} stroke="var(--art-2)" stroke-opacity="0.6" stroke-dasharray="2 2" />
      <line data-part="vec" x1={s.origin[0]} y1={s.origin[1]} x2={s.tip[0]} y2={s.tip[1]} stroke="var(--art-1)" stroke-width="2" stroke-linecap="round" />
      <circle data-part="glow" cx={s.tip[0]} cy={s.tip[1]} r="8" fill="var(--art-3)" fill-opacity="0.45" />
      <circle data-part="tip" cx={s.tip[0]} cy={s.tip[1]} r="3.5" fill="var(--art-1)" />
      <circle cx={s.origin[0]} cy={s.origin[1]} r="2" fill="var(--muted)" />
    </g>
  </svg>
</figure>

<style>
  /* The dashed orbit slowly flows in the direction of precession. */
  .bloch-orbit {
    animation: orbit-flow 2.4s linear infinite;
  }
  @keyframes orbit-flow {
    to {
      stroke-dashoffset: -12;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bloch-orbit {
      animation: none;
    }
  }
</style>

<script>
  import { project, stateFrame, THETA } from "../../utils/bloch";

  const group = document.querySelector<SVGGElement>("[data-bloch-state]");

  if (group && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const one = (name: string) => group.querySelector(`[data-part="${name}"]`)!;
    const trail = [...group.querySelectorAll('[data-part="trail"]')];
    const trailOpacity = trail.map((el) => Number(el.getAttribute("opacity")));
    const [vec, proj, drop, glow, tip, ring] = ["vec", "proj", "drop", "glow", "tip", "ring"].map(one);
    const set = (el: Element, attrs: Record<string, number>) => {
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v.toFixed(2));
    };

    // Timeline (seconds): precess, then a "measurement" collapses the state to
    // a pole with probability cos²(θ/2) / sin²(θ/2), holds, and drifts back.
    const PRECESS = 8, COLLAPSE = 0.7, HOLD = 1.3, RETURN = 1.4, RIPPLE = 0.9;
    const CYCLE = PRECESS + COLLAPSE + HOLD + RETURN;
    const P_ZERO = Math.cos(THETA / 2) ** 2;
    const ease = (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * ease(Math.min(Math.max(t, 0), 1));

    let cycle = -1;
    let target = 0;
    const start = performance.now();

    const draw = (now: number) => {
      const t = (now - start) / 1000;
      const n = Math.floor(t / CYCLE);
      if (n !== cycle) {
        cycle = n;
        target = Math.random() < P_ZERO ? 0 : Math.PI;
      }
      const local = t - n * CYCLE;
      const arrive = PRECESS + COLLAPSE;
      const theta =
        local < PRECESS ? THETA
        : local < arrive ? lerp(THETA, target, (local - PRECESS) / COLLAPSE)
        : local < arrive + HOLD ? target
        : lerp(target, THETA, (local - arrive - HOLD) / RETURN);
      const phi = 0.9 + t * 0.55;

      const f = stateFrame(theta, phi);
      set(vec, { x2: f.tip[0], y2: f.tip[1] });
      set(proj, { x2: f.foot[0], y2: f.foot[1] });
      set(drop, { x1: f.tip[0], y1: f.tip[1], x2: f.foot[0], y2: f.foot[1] });
      set(tip, { cx: f.tip[0], cy: f.tip[1] });
      set(glow, { cx: f.tip[0], cy: f.tip[1], r: 8 + 2.5 * Math.sin(t * 2.6) });
      group.style.opacity = f.front ? "1" : "0.55";

      trail.forEach((el, i) => {
        const p = stateFrame(theta, phi - (i + 1) * 0.07);
        set(el, { cx: p.tip[0], cy: p.tip[1], opacity: trailOpacity[i] * (p.front ? 1 : 0.5) });
      });

      // Ripple at the pole the state collapsed to.
      const since = local - arrive;
      if (since >= 0 && since < RIPPLE) {
        const [px, py] = project([0, 0, target === 0 ? 1 : -1]);
        set(ring, { cx: px, cy: py, r: 4 + 18 * (since / RIPPLE), opacity: 0.9 * (1 - since / RIPPLE) });
      } else {
        ring.setAttribute("opacity", "0");
      }
    };

    // Only animate while the sphere is on screen.
    let visible = false;
    const loop = (now: number) => {
      draw(now);
      if (visible) requestAnimationFrame(loop);
    };
    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      if (visible && !wasVisible) requestAnimationFrame(loop);
    }).observe(group);
  }
</script>

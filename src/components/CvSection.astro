---
import type { CvEntry } from "../data/cv";

interface Props {
  title: string;
  entries: CvEntry[];
}

const { title, entries } = Astro.props;
---

<section class="mt-20 first:mt-0">
  <h2 class="section-label">{title}</h2>
  <ol class="space-y-8">
    {
      entries.map(({ title, org, url, location, period, details }) => (
        <li class="grid gap-x-8 gap-y-1 sm:grid-cols-[7rem_1fr]">
          <p class="font-mono text-xs leading-6 tracking-wider text-muted uppercase">{period}</p>
          <div>
            <h3 class="text-base leading-6">{title}</h3>
            <p class="text-sm text-muted">
              {url ? <a class="link" href={url} target="_blank" rel="noopener noreferrer">{org}</a> : org}
              {location && <span> &middot; {location}</span>}
            </p>
            {details && details.length > 0 && (
              <ul class="mt-2 space-y-1 text-sm">
                {details.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

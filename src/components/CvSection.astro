---
import Card from "./ui/Card.astro";
import Section from "./ui/Section.astro";
import type { CvEntry } from "../data/cv";
import { linkProps } from "../utils/links";

interface Props {
  title: string;
  eyebrow?: string;
  entries: CvEntry[];
}

const { title, eyebrow, entries } = Astro.props;
---

{entries.length > 0 && (
<Section title={title} eyebrow={eyebrow} class="border-t border-line">
  <Card padded={false} class="max-w-4xl" data-reveal>
    <ol class="divide-y divide-line">
      {
        entries.map(({ title, org, url, location, period, details }) => (
          <li class="grid gap-x-8 gap-y-2 px-6 py-6 sm:grid-cols-[9rem_1fr] md:px-8 md:py-7" data-companion-item data-companion-title={`${title}, ${org}`}>
            <p class="text-sm font-semibold text-muted tabular-nums sm:pt-0.5">{period}</p>
            <div>
              <h3 class="text-lg leading-snug">{title}</h3>
              <p class="mt-1 text-base text-muted">
                {url ? <a class="link" href={url} {...linkProps(url)}>{org}</a> : org}
                {location && <span> &middot; {location}</span>}
              </p>
              {details && details.length > 0 && (
                <ul class="mt-3 max-w-2xl list-disc space-y-1.5 pl-5 text-base leading-relaxed marker:text-line">
                  {details.map((d) => <li>{d}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Card>
</Section>
)}

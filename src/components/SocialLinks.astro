---
import Icon, { type IconName } from "./Icon.astro";
import { site } from "../data/site";
import { linkProps } from "../utils/links";

interface Props {
  size?: "sm" | "md";
}

const { size = "md" } = Astro.props;

const links: { label: string; href: string; icon: IconName }[] = [
  { label: "GitHub", href: site.socials.github, icon: "github" },
  { label: "Google Scholar", href: site.socials.scholar, icon: "scholar" },
  { label: "LinkedIn", href: site.socials.linkedin, icon: "linkedin" },
  { label: "Email", href: site.socials.email, icon: "mail" },
];

const box = size === "sm" ? "size-11 rounded-lg" : "size-11 rounded-xl";
const icon = size === "sm" ? "size-4" : "size-[18px]";
---

<ul class="flex items-center gap-2">
  {
    links.map(({ label, href, icon: name }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          {...linkProps(href)}
          class:list={[
            box,
            "comic-button grid place-items-center bg-card text-fg hover:text-link",
          ]}
        >
          <Icon name={name} class={icon} />
        </a>
      </li>
    ))
  }
</ul>

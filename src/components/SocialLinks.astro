---
import Icon, { type IconName } from "./Icon.astro";
import { site } from "../data/site";

interface Props {
  size?: "sm" | "md";
}

const { size = "md" } = Astro.props;

const links: { label: string; href: string; icon: IconName }[] = [
  { label: "GitHub", href: site.socials.github, icon: "github" },
  { label: "Google Scholar", href: site.socials.scholar, icon: "scholar" },
  { label: "LinkedIn", href: site.socials.linkedin, icon: "linkedin" },
  { label: "Email", href: `mailto:${site.email}`, icon: "mail" },
];

const icon = size === "sm" ? "size-4" : "size-[18px]";
---

<ul class:list={["flex items-center", size === "sm" ? "gap-4" : "gap-5"]}>
  {
    links.map(({ label, href, icon: name }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          target={href.startsWith("mailto:") ? undefined : "_blank"}
          rel="noopener noreferrer"
          class="block text-accent transition-colors hover:text-accent-hover"
        >
          <Icon name={name} class={icon} />
        </a>
      </li>
    ))
  }
</ul>
